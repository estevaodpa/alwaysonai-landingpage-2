# Meta Pixel (Facebook)
# Deixe vazio para desativar o Pixel. Preencha com o Pixel ID (ex.: 123456789012345) para ativar.
NEXT_PUBLIC_META_PIXEL_ID=

# Webhook do n8n (diagnóstico progressivo)
# Opcional: quando vazio, o site usa a URL padrão de produção definida em
# app/lib/diagnostic-river.ts (diagnosticConfig.n8nWebhookUrl).
# Preencha para apontar a um ambiente de teste (ex.: URL de staging do n8n).
NEXT_PUBLIC_N8N_WEBHOOK_URL=
